# ==============================================================================
# HANOI SATELLITE WEBGIS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://localhost:8000"]

# Database Configuration (Mặc định dùng SQLite cục bộ, có thể chuyển sang PostgreSQL)
DATABASE_URL=sqlite:///./data/webgis.db

# Cloudflare R2 Credentials (Lấy từ Cloudflare Dashboard -> R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=webgis-hanoi

# (Tùy chọn) R2 Public Domain hoặc Custom Domain nếu cấu hình public bucket
# Ví dụ: https://pub-xxxxxxxxxxxxxx.r2.dev hoặc https://data.yourdomain.com
R2_PUBLIC_URL=

# Microsoft Planetary Computer STAC Endpoint
MPC_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# (Tùy chọn) MPC API Key nếu có (cho quota cao hơn, tài khoản miễn phí bình thường không bắt buộc)
PC_SDK_SUBSCRIPTION_KEY=

# Geospatial Settings
HANOI_BBOX=[105.25,20.55,106.02,21.45]
HANOI_BOUNDARY_PATH=./data/boundaries/hanoi.geojson
TEMP_DIR=./data/temp
MAX_CLOUD_COVER=40.0
